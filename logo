{
  "name": "Ágora · Participación ciudadana de Niki",
  "short_name": "Ágora",
  "description": "Demo educativa de participación ciudadana en la Lumencracia de la República de Niki.",
  "lang": "es",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#bfeeff",
  "theme_color": "#14b8c4",
  "icons": [
    { "src": "icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ]
}

/* Ágora — estética Frutiger Aero */
:root {
  /* Paleta Frutiger Aero / Eco de Ágora */
  --turq: #79DCE8;
  --turq-d: #2BA9B8;
  --green: #8BD66A;
  --green-d: #4FA83A;
  --sky: #A8E7F7;
  --orange: #FF922E;
  --orange-d: #E8730C;
  --yellow: #FFE15A;
  --white: #FFFFFF;
  --ink: #086B71;
  --ink-soft: #3E7F86;
  --glass: rgba(255, 255, 255, 0.62);
  --glass-strong: rgba(255, 255, 255, 0.82);
  --line: rgba(255, 255, 255, 0.95);
  --shadow: 0 10px 28px rgba(0, 92, 122, 0.18);
  --r: 20px;
  --font: "Segoe UI", "Frutiger", "Myriad Pro", "Helvetica Neue", Roboto, Arial, sans-serif;
  --safe-b: env(safe-area-inset-bottom, 0px);
}

* { box-sizing: border-box; -webkit-tap-highlight-color: transparent; }
html, body { margin: 0; padding: 0; }
body {
  font-family: var(--font);
  color: var(--ink);
  font-size: 15px;
  line-height: 1.45;
  min-height: 100vh;
  background: #A8E7F7;
  overflow-x: hidden;
}
body::before {
  content: ""; position: fixed; inset: 0; z-index: -1; pointer-events: none;
  background:
    linear-gradient(180deg, rgba(255,255,255,.10) 0%, rgba(240,252,255,.30) 35%, rgba(240,252,255,.50) 70%, rgba(240,253,245,.62) 100%),
    url(fondo.webp) center top / cover no-repeat,
    linear-gradient(180deg, #3fb8ec 0%, #A8E7F7 60%, #8BD66A 100%);
}

/* Burbujas decorativas */
.bubbles { position: fixed; inset: 0; pointer-events: none; z-index: 0; overflow: hidden; }
.bubbles span {
  position: absolute; bottom: -80px; border-radius: 50%;
  background: radial-gradient(circle at 32% 28%, rgba(255,255,255,.95) 0 9%, rgba(255,255,255,.25) 22%, rgba(180,240,255,.18) 60%, rgba(255,255,255,.55) 100%);
  border: 1px solid rgba(255,255,255,.7);
  animation: rise linear infinite;
}
@keyframes rise { to { transform: translateY(-120vh) translateX(30px); } }
@media (prefers-reduced-motion: reduce) { .bubbles span { animation: none; display: none; } }

#app { position: relative; z-index: 1; max-width: 520px; margin: 0 auto; padding: 0 16px calc(32px + var(--safe-b)); }

/* Barra superior */
.topbar {
  position: sticky; top: env(safe-area-inset-top, 0px); z-index: 20; margin: 0 -16px; padding: 10px 16px;
  display: flex; align-items: center; gap: 10px;
  background: linear-gradient(180deg, rgba(255,255,255,.82), rgba(255,255,255,.55));
  backdrop-filter: blur(14px); -webkit-backdrop-filter: blur(14px);
  border-bottom: 1px solid rgba(255,255,255,.9);
  box-shadow: 0 4px 18px rgba(0, 90, 120, .12);
}
.topbar .brand { flex: 1; display: flex; align-items: center; gap: 8px; text-decoration: none; color: var(--ink); }
.topbar .brand b { font-size: 21px; letter-spacing: .5px; background: linear-gradient(180deg, #2BA9B8, #086B71); -webkit-background-clip: text; background-clip: text; color: transparent; }
.icon-btn {
  width: 42px; height: 42px; border-radius: 14px; border: 1px solid rgba(255,255,255,.95);
  background: linear-gradient(180deg, #ffffff 0%, #e3f7fb 50%, #c9eef5 51%, #e9fbff 100%);
  box-shadow: 0 3px 10px rgba(0,100,130,.18), inset 0 1px 0 #fff;
  display: grid; place-items: center; cursor: pointer; color: var(--turq-d);
}
.icon-btn svg { width: 22px; height: 22px; }
.user-chip {
  font-size: 13px; font-weight: 600; padding: 7px 12px; border-radius: 999px; cursor: pointer;
  border: 1px solid rgba(255,255,255,.95); color: var(--ink);
  background: linear-gradient(180deg, #fff, #dff5fa); box-shadow: 0 2px 8px rgba(0,100,130,.15);
  max-width: 150px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
}

/* Vidrio */
.glass {
  background: linear-gradient(180deg, var(--glass-strong), var(--glass));
  border: 1px solid var(--line);
  border-radius: var(--r);
  box-shadow: var(--shadow), inset 0 1px 0 #fff;
  backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px);
  padding: 16px;
  margin: 14px 0;
  position: relative;
}
.glass.tight { padding: 12px; }
.section-title { display: flex; align-items: center; justify-content: space-between; gap: 8px; margin: 22px 2px 8px; }
.section-title h2 { margin: 0; font-size: 19px; color: var(--ink); text-shadow: 0 1px 0 rgba(255,255,255,.9); }
.section-title a, .link { color: var(--turq-d); font-weight: 600; font-size: 14px; text-decoration: none; cursor: pointer; background: none; border: 0; font-family: inherit; padding: 0; }
h1, h2, h3 { line-height: 1.2; }
h3 { margin: 0 0 6px; font-size: 16px; }
p { margin: 6px 0; }
.muted { color: var(--ink-soft); font-size: 13px; }
.small { font-size: 12.5px; }

/* Botones brillantes */
.btn {
  position: relative; overflow: hidden; display: inline-flex; align-items: center; justify-content: center; gap: 8px;
  font: 700 15px var(--font); color: #05565b; text-decoration: none; cursor: pointer;
  padding: 11px 20px; border-radius: 999px; border: 1px solid var(--turq-d);
  background: linear-gradient(180deg, #e4fbfd 0%, #a9ebf2 46%, #79DCE8 50%, #5fd1df 80%, #9ae6ef 100%);
  box-shadow: 0 4px 14px rgba(43, 169, 184, .45), inset 0 1px 0 #fff, inset 0 -3px 8px rgba(8,107,113,.18);
  text-shadow: 0 1px 0 rgba(255,255,255,.7);
  transition: transform .12s ease, filter .12s ease;
}
.btn::before {
  content: ""; position: absolute; left: 6%; right: 6%; top: 2px; height: 46%; border-radius: 999px;
  background: linear-gradient(180deg, rgba(255,255,255,.85), rgba(255,255,255,.1)); pointer-events: none;
}
.btn:active { transform: scale(.97); filter: brightness(.96); }
.btn.green { color: #24520f; border-color: var(--green-d); background: linear-gradient(180deg, #ecfbe2 0%, #b9eb9f 46%, #8BD66A 50%, #74c955 80%, #a9e38d 100%); box-shadow: 0 4px 14px rgba(79,168,58,.4), inset 0 1px 0 #fff, inset 0 -3px 8px rgba(40,100,20,.18); }
.btn.orange { color: #fff; text-shadow: 0 1px 2px rgba(150,60,0,.5); border-color: var(--orange-d); background: linear-gradient(180deg, #FFE15A 0%, #ffbf4a 40%, #FF922E 52%, #f5801c 80%, #ffa64d 100%); box-shadow: 0 4px 14px rgba(255,146,46,.45), inset 0 1px 0 rgba(255,255,255,.9), inset 0 -3px 8px rgba(150,60,0,.2); }
.btn.yellow { color: #6a4a00; border-color: #e6bf1f; background: linear-gradient(180deg, #fffbe0 0%, #fff09a 46%, #FFE15A 50%, #ffd636 80%, #ffec8a 100%); box-shadow: 0 4px 14px rgba(230,190,30,.4), inset 0 1px 0 #fff; }
.btn.ghost { color: var(--turq-d); text-shadow: none; border-color: rgba(10,143,156,.35); background: linear-gradient(180deg, #ffffff 0%, #ecfbfd 50%, #d9f4f8 51%, #f1fdff 100%); }
.btn.small { padding: 7px 14px; font-size: 13.5px; }
.btn.block { display: flex; width: 100%; }
.btn[disabled] { opacity: .55; cursor: not-allowed; filter: grayscale(.4); }
.btn-row { display: flex; gap: 10px; flex-wrap: wrap; margin-top: 12px; }

/* Orbes (iconos brillantes) */
.orb {
  --c: var(--turq);
  width: 64px; height: 64px; border-radius: 50%; display: grid; place-items: center; font-size: 28px; position: relative;
  background: radial-gradient(circle at 50% 120%, color-mix(in srgb, var(--c) 55%, #fff) 0%, var(--c) 45%, color-mix(in srgb, var(--c) 70%, #003040) 100%);
  border: 2px solid rgba(255,255,255,.9);
  box-shadow: 0 6px 14px color-mix(in srgb, var(--c) 45%, transparent), inset 0 -4px 10px rgba(0,0,0,.15);
}
.orb::after {
  content: ""; position: absolute; left: 14%; right: 14%; top: 5%; height: 45%; border-radius: 50%;
  background: linear-gradient(180deg, rgba(255,255,255,.9), rgba(255,255,255,.05));
}
.orb.sm { width: 44px; height: 44px; font-size: 20px; }
.orb.lg { width: 84px; height: 84px; font-size: 38px; }

/* Hero */
.hero { text-align: center; padding: 26px 18px 20px; overflow: hidden; }
.hero .logo { width: 108px; height: 108px; margin: 0 auto 6px; filter: drop-shadow(0 8px 16px rgba(0,110,140,.35)); }
.hero h1 { margin: 6px 0 4px; font-size: 30px; color: var(--ink); text-shadow: 0 2px 0 #fff; }
.hero .sub { color: var(--ink-soft); margin: 0 auto 12px; max-width: 360px; }
.hero::before {
  content: ""; position: absolute; inset: -40% -20% auto; height: 70%;
  background: radial-gradient(ellipse at 50% 100%, rgba(255,255,255,.75), rgba(255,255,255,0) 70%); pointer-events: none;
}

.demo-ribbon {
  display: flex; gap: 10px; align-items: flex-start; font-size: 12.5px; color: #6b3d00;
  background: linear-gradient(180deg, rgba(255,240,210,.92), rgba(255,226,170,.8));
  border: 1px solid rgba(255,255,255,.95); border-radius: 14px; padding: 9px 12px; margin: 12px 0;
  box-shadow: 0 4px 12px rgba(200,120,0,.15);
}

/* Chips y badges */
.chips { display: flex; gap: 8px; overflow-x: auto; padding: 4px 2px 8px; scrollbar-width: none; }
.chips::-webkit-scrollbar { display: none; }
.chip {
  flex: none; font: 600 13px var(--font); padding: 7px 13px; border-radius: 999px; cursor: pointer; color: var(--ink);
  border: 1px solid rgba(255,255,255,.95); background: linear-gradient(180deg, #ffffff, #e2f6fa);
  box-shadow: 0 2px 6px rgba(0,100,130,.12);
}
.chip.on { color: #05565b; border-color: var(--turq-d); background: linear-gradient(180deg, #e4fbfd, #79DCE8 55%, #5fd1df); box-shadow: 0 2px 8px rgba(43,169,184,.35), inset 0 1px 0 #fff; }
.badge { display: inline-block; font-size: 11.5px; font-weight: 700; padding: 3px 9px; border-radius: 999px; color: #fff; background: var(--turq); vertical-align: middle; letter-spacing: .2px; }
.badge.orange { background: var(--orange); }
.badge.green { background: var(--green-d); }
.badge.gray { background: #7e98a2; }
.badge.purple { background: #8a5cd6; }
.badge.red { background: #e2475d; }
.badge.outline { background: rgba(255,255,255,.7); color: var(--ink); border: 1px solid rgba(10,143,156,.35); }

/* Listas de tarjetas */
.card-list { display: grid; gap: 10px; }
.item {
  display: block; text-decoration: none; color: inherit; cursor: pointer; text-align: left; width: 100%; font: inherit;
  background: linear-gradient(180deg, rgba(255,255,255,.9), rgba(255,255,255,.66));
  border: 1px solid var(--line); border-radius: 16px; padding: 12px 14px;
  box-shadow: 0 4px 14px rgba(0,92,122,.12), inset 0 1px 0 #fff;
}
.item:active { transform: scale(.99); }
.item .meta { display: flex; flex-wrap: wrap; gap: 6px; align-items: center; margin-bottom: 4px; }
.item h3 { margin: 2px 0 4px; }
.row { display: flex; align-items: center; gap: 12px; }
.row .grow { flex: 1; min-width: 0; }

/* Noticias */
.news-feature { border-left: 5px solid var(--orange); }
.news-cat { font-size: 11.5px; font-weight: 700; text-transform: uppercase; letter-spacing: .6px; color: var(--turq-d); }
.news-date { font-size: 12px; color: var(--ink-soft); }
.news-body { display: none; margin-top: 6px; }
.item.open .news-body { display: block; }

/* Calendario */
.cal-head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 8px; }
.cal-head h3 { margin: 0; }
.cal-grid { display: grid; grid-template-columns: repeat(7, 1fr); gap: 4px; text-align: center; }
.cal-grid .dow { font-size: 11px; font-weight: 700; color: var(--ink-soft); padding: 2px 0; }
.cal-day {
  position: relative; aspect-ratio: 1; border-radius: 12px; display: grid; place-items: center; font-weight: 600; font-size: 14px;
  background: rgba(255,255,255,.55); border: 1px solid rgba(255,255,255,.9); cursor: pointer; color: var(--ink); font-family: inherit; padding: 0;
}
.cal-day.empty { background: none; border: 0; cursor: default; }
.cal-day.today { background: linear-gradient(180deg, #FFE15A, #FF922E); color: #fff; border-color: var(--orange-d); text-shadow: 0 1px 2px rgba(150,60,0,.45); }
.cal-day.sel { outline: 3px solid var(--turq-d); outline-offset: -1px; }
.cal-day .dots { position: absolute; bottom: 4px; left: 0; right: 0; display: flex; justify-content: center; gap: 2px; }
.cal-day .dots i { width: 5px; height: 5px; border-radius: 50%; background: var(--orange); }
.cal-day.today .dots i { background: #fff; }
.ev { display: flex; gap: 10px; align-items: flex-start; padding: 8px 0; border-top: 1px solid rgba(10,143,156,.12); }
.ev:first-child { border-top: 0; }
.ev .d { flex: none; width: 44px; text-align: center; border-radius: 12px; padding: 4px 0; background: linear-gradient(180deg, #fff, #dff5fa); border: 1px solid #fff; font-weight: 700; color: var(--turq-d); }
.ev .d small { display: block; font-size: 10px; text-transform: uppercase; color: var(--ink-soft); font-weight: 600; }

/* Provincias */
.prov-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
.prov-card {
  --c: var(--turq); position: relative; overflow: hidden; text-decoration: none; color: #fff; border-radius: 18px; padding: 14px 12px 12px; min-height: 96px;
  background: linear-gradient(160deg, color-mix(in srgb, var(--c) 55%, #fff) 0%, var(--c) 55%, color-mix(in srgb, var(--c) 75%, #00303c) 100%);
  border: 1px solid rgba(255,255,255,.9); box-shadow: 0 6px 16px color-mix(in srgb, var(--c) 35%, transparent), inset 0 1px 0 rgba(255,255,255,.8);
  text-shadow: 0 1px 2px rgba(0,40,50,.45); display: flex; flex-direction: column; justify-content: flex-end;
}
.prov-card::before { content: ""; position: absolute; left: -10%; right: -10%; top: -30%; height: 75%; border-radius: 50%; background: linear-gradient(180deg, rgba(255,255,255,.55), rgba(255,255,255,0)); }
.prov-card b { position: relative; font-size: 15.5px; line-height: 1.15; }
.prov-card span { position: relative; font-size: 12px; opacity: .95; }
.prov-card .num { position: absolute; top: 8px; right: 10px; font-size: 12px; font-weight: 700; opacity: .85; }

.banner {
  --c: var(--turq); color: #fff; border-radius: 22px; padding: 18px; margin: 14px 0; position: relative; overflow: hidden;
  background: linear-gradient(160deg, color-mix(in srgb, var(--c) 50%, #fff) 0%, var(--c) 50%, color-mix(in srgb, var(--c) 70%, #00303c) 100%);
  border: 1px solid rgba(255,255,255,.9); box-shadow: 0 10px 24px color-mix(in srgb, var(--c) 40%, transparent);
  text-shadow: 0 1px 2px rgba(0,40,50,.4);
}
.banner::before { content: ""; position: absolute; left: -10%; right: -10%; top: -45%; height: 80%; border-radius: 50%; background: linear-gradient(180deg, rgba(255,255,255,.5), rgba(255,255,255,0)); }
.banner > * { position: relative; }
.banner h1 { margin: 2px 0; font-size: 26px; }
.banner .kv { display: flex; gap: 14px; flex-wrap: wrap; font-size: 13px; margin-top: 8px; }

.nodo-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 12px 6px; }
.nodo-tile { display: flex; flex-direction: column; align-items: center; gap: 6px; text-decoration: none; color: var(--ink); text-align: center; font-size: 12px; font-weight: 600; line-height: 1.15; }

/* Tabs internas */
.tabs { display: flex; gap: 6px; overflow-x: auto; scrollbar-width: none; padding: 4px; border-radius: 999px; background: rgba(255,255,255,.5); border: 1px solid #fff; margin: 12px 0; }
.tabs::-webkit-scrollbar { display: none; }
.tabs a { flex: 1 0 auto; text-align: center; text-decoration: none; color: var(--ink); font-weight: 600; font-size: 13.5px; padding: 8px 12px; border-radius: 999px; }
.tabs a.on { color: #05565b; background: linear-gradient(180deg, #e4fbfd 0%, #a9ebf2 46%, #79DCE8 50%, #9ae6ef 100%); box-shadow: 0 2px 8px rgba(43,169,184,.35), inset 0 1px 0 #fff; }

/* Progreso */
.progress { height: 14px; border-radius: 999px; background: rgba(255,255,255,.7); border: 1px solid rgba(10,143,156,.25); overflow: hidden; position: relative; }
.progress > i { display: block; height: 100%; border-radius: 999px; background: linear-gradient(180deg, #d9f5c8 0%, #8BD66A 50%, #6cc24b 51%, #a2e083 100%); box-shadow: inset 0 1px 0 rgba(255,255,255,.7); }
.progress.turq > i { background: linear-gradient(180deg, #d6f8fb 0%, #79DCE8 50%, #4ccbd9 51%, #8fe3ec 100%); }
.progress.orange > i { background: linear-gradient(90deg, #FFE15A, #FF922E); box-shadow: inset 0 1px 0 rgba(255,255,255,.8); }

/* Contador */
.counter { display: grid; grid-template-columns: repeat(3, 1fr); gap: 8px; margin: 10px 0; }
.counter.six { grid-template-columns: repeat(6, 1fr); gap: 5px; }
.counter div { text-align: center; border-radius: 14px; padding: 8px 2px; background: linear-gradient(180deg, #ffffff 0%, #e7f9fc 50%, #d2f1f7 51%, #f2fdff 100%); border: 1px solid #fff; box-shadow: 0 3px 10px rgba(0,100,130,.15); }
.counter b { display: block; font-size: 22px; color: var(--ink); font-variant-numeric: tabular-nums; }
.counter.six b { font-size: 18px; }
.counter span { font-size: 10.5px; color: var(--ink-soft); text-transform: uppercase; font-weight: 700; letter-spacing: .3px; }
.counter.down b { color: var(--orange-d); }

/* Pasos */
.steps { list-style: none; padding: 0; margin: 8px 0 0; counter-reset: s; }
.steps li { position: relative; padding: 4px 0 12px 42px; counter-increment: s; }
.steps li::before {
  content: counter(s); position: absolute; left: 0; top: 2px; width: 30px; height: 30px; border-radius: 50%; display: grid; place-items: center; color: #fff; font-weight: 700; text-shadow: 0 1px 2px rgba(8,107,113,.6);
  background: radial-gradient(circle at 50% 120%, #e6fbe0, #8BD66A 40%, #2BA9B8 85%); border: 2px solid #fff; box-shadow: 0 3px 8px rgba(0,110,130,.3);
}
.steps li:not(:last-child)::after { content: ""; position: absolute; left: 15px; top: 34px; bottom: 0; width: 2px; background: rgba(20,184,196,.35); }

.list-check { list-style: none; padding: 0; margin: 6px 0; }
.list-check li { padding: 4px 0 4px 26px; position: relative; }
.list-check li::before { content: "✔"; position: absolute; left: 2px; color: var(--green-d); font-weight: 700; }
.list-check.no li::before { content: "✖"; color: #e2475d; }

/* Formularios */
label.f { display: block; font-weight: 600; font-size: 13.5px; margin: 12px 0 5px; }
input.in, select.in, textarea.in {
  width: 100%; font: 15px var(--font); color: var(--ink); padding: 11px 13px; border-radius: 14px;
  border: 1px solid rgba(10,143,156,.3); background: rgba(255,255,255,.9); box-shadow: inset 0 2px 4px rgba(0,80,100,.08);
}
textarea.in { min-height: 110px; resize: vertical; }
input.in:focus, select.in:focus, textarea.in:focus { outline: 3px solid rgba(20,184,196,.35); border-color: var(--turq); }
.elysia-hint {
  display: none; margin-top: 10px; padding: 10px 12px; border-radius: 14px; font-size: 13.5px;
  background: linear-gradient(180deg, rgba(225,250,255,.95), rgba(200,240,250,.85)); border: 1px solid #fff; box-shadow: 0 3px 10px rgba(0,100,130,.12);
}
.elysia-hint.show { display: block; }

/* Opciones de voto */
.opt {
  display: flex; align-items: center; gap: 10px; padding: 12px; border-radius: 14px; margin: 8px 0; cursor: pointer;
  background: rgba(255,255,255,.8); border: 2px solid rgba(255,255,255,.95); box-shadow: 0 2px 8px rgba(0,100,130,.1); font-weight: 600;
}
