  const s = clasificar(f.titulo.value + ' ' + f.cuerpo.value), h = $('#hint');
  if (!s) { h.classList.remove('show'); return; }
  const N = NODO(s.nodo); h.classList.add('show');
  h.innerHTML = `✨ <b>Elysia sugiere:</b> Nodo de ${esc(N.nombre)} › ${esc(s.tema)}
